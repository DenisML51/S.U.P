# Copy to .env. Used by docker-compose and by `npm run dev` for local development.

# --- Secrets -------------------------------------------------------------------
# Signing key for access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars

POSTGRES_USER=itd
POSTGRES_PASSWORD=itd
POSTGRES_DB=into_the_dark

# --- Behaviour -----------------------------------------------------------------
# Self-service sign-up. With false, create accounts with:
#   docker compose exec api node dist/cli.js create-user --email ... --name ...
REGISTRATION_ENABLED=true
# true when the site is served over HTTPS
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Ports ---------------------------------------------------------------------
WEB_PORT=3000
POSTGRES_PORT=5432

# --- Local development (npm run dev) -------------------------------------------
# The API run outside Docker talks to the compose Postgres published on localhost.
DATABASE_URL=postgres://itd:itd@localhost:5432/into_the_dark

# Optional local dev account for UI work, created with:
#   npm run cli -- create-user --email $DEV_USER_EMAIL --name Dev --password $DEV_USER_PASSWORD
DEV_USER_EMAIL=dev@itd.test
DEV_USER_PASSWORD=
